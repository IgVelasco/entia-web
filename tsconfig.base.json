{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2022",
    "lib": [
      "es2023",
      "dom",
      "dom.iterable"
    ],
    "skipLibCheck": true,
    "strict": false,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true
  }
}
