  "compilerOptions": {
    "noEmit": true,
    "target": "es2022",
    "lib": ["es2023", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "strict": true,
    "erasableSyntaxOnly": true
  },
  "include": ["e2e", "playwright.config.ts"]
}
